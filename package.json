{
  "name": "@watchnoc/node",
  "version": "0.1.0",
  "description": "Watchnoc observability SDK for Node.js",
  "type": "module",
  "license": "MIT",
  "author": "Watchnoc",
  "homepage": "https://github.com/watchnoc/node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchnoc/node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/watchnoc/node-sdk/issues"
  },
  "keywords": [
    "watchnoc",
    "observability",
    "logging",
    "apm",
    "error-tracking",
    "tracing",
    "monitoring",
    "nodejs",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "prepublishOnly": "npm run build && npm run typecheck:examples && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@watchnoc/proto": "github:watchnoc/proto#v0.1.3",
    "protobufjs": "^7.2.6",
    "undici": "^6.19.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^4.19.2",
    "mongoose": "^9.4.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "typescript": "5.5.4",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "express": ">=4",
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
